## 데이터 모델

```typescript
// thinking-types.ts

type ThinkingStage = "framing" | "dump" | "frame-select" | "distill" | "decide" | "reflect";

type DistillFrameType = 
  | "now-next-later" | "eisenhower-matrix" | "emotion-fact"
  | "statistical-check" | "cause-core-response" | "moscow";

interface DumpItem {
  id: string;
  text: string;
  createdAt: number;
}

interface DistilledItem {
  id: string;
  text: string;
  slot: string;
  sourceId?: string;
}

interface ActionItem {
  id: string;
  text: string;
  emoji?: string;
  scheduledTime?: string;
  completed: boolean;
}

interface SessionReflection {
  mood: "great" | "good" | "neutral" | "tough";
  comment?: string;
}

interface ThinkingSession {
  id: string;
  createdAt: number;
  completedAt?: number;
  framingText: string;
  tags: string[];
  dumpItems: DumpItem[];
  dumpDurationSecs: number;
  selectedFrame: DistillFrameType;
  distilledItems: DistilledItem[];
  actionItems: ActionItem[];
  reviewTime?: string;
  reflection?: SessionReflection;
  totalDurationSecs: number;
  completionRate: number;
  stageReached: ThinkingStage;
}
```

